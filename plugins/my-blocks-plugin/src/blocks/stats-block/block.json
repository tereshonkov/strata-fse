{
    "apiVersion": 3,
    "name": "my-plugin/stats-block",
    "title": "Stats Block",
    "category": "theme",
    "description": "Stats section for STRATA construction landing",
    "supports": {
        "html": false
    },
    "attributes": {
        "stats": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "value": { "type": "string" },
                    "suffix": { "type": "string" },
                    "label": { "type": "string" }
                }
            },
            "default": [
                {
                    "value": "12",
                    "label": "Years in business"
                },
                {
                    "value": "340",
                    "label": "Projects Completed"
                },
                {
                    "value": "98",
                    "suffix": "%",
                    "label": "Client satisfaction"
                },
                {
                    "value": "45",
                    "label": "In-house specialists"
                }
            ]
        }
    },
    "editorScript": "file:../../../build/index.js",
    "style": "file:../../../build/style-index.css"
}